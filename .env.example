# Required for admin API access after deployment. Use a long random value.
ADMIN_API_KEY=replace-with-a-long-random-secret

# The demo never requests or transfers real money. Keep this at demo until
# merchant credentials and the payment provider's current API contract exist.
PAYMENT_MODE=demo

# Production hosting may require 0.0.0.0. Local default is 127.0.0.1.
HOST=127.0.0.1
PORT=4174
